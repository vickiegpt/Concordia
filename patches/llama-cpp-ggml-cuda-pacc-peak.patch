--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1,0 +2 @@
+#include "ggml-cpu.h"
@@ -85,0 +87 @@
+#include <cstring>
@@ -2542,0 +2545,345 @@
+
+// ---- hetGPU PACC quantized offload hook (IQ1_S native + others via F32) ---
+#include <mutex>
+#include <atomic>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <thread>
+#include <unistd.h>
+#include <unordered_map>
+#include <vector>
+extern "C" int hetgpu_pacc_submit_gemm(int, int, int, int, int, const void *,
+    const void *, int, int, long long, const void *, int, int, long long,
+    const void *, void *, int, int, long long, int, int);
+static bool ggml_pacc_iq1s_enabled() {
+    static int v = -1;
+    if (v < 0) { const char * e = getenv("HETGPU_PACC_IQ1S_HOOK"); v = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+        fprintf(stderr, "[pacc-iq1s] hook enabled=%d (env=%s)\n", v, e?e:"(unset)"); }
+    return v == 1;
+}
+
+// Keep unsupported fake-CUDA quantized kernels out of the mixed path while
+// reusing llama.cpp's optimized host quantized dot products. This is enabled
+// only when an explicit PACC shape filter is active.
+static bool ggml_cuda_pacc_cpu_mul_mat(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const auto * traits = ggml_get_type_traits_cpu(src0->type);
+    if (!traits || !traits->vec_dot) return false;
+    const auto * rhs_traits = ggml_get_type_traits_cpu(traits->vec_dot_type);
+    if (!rhs_traits || !rhs_traits->from_float) return false;
+
+    const long long k = src0->ne[0], m = src0->ne[1], n = src1->ne[1];
+    const size_t weight_row_bytes = ggml_row_size(src0->type, k);
+    const size_t weight_bytes = weight_row_bytes * (size_t) m;
+    const size_t rhs_row_bytes = ggml_row_size(traits->vec_dot_type, k);
+    const size_t rhs_f32_bytes = (size_t) k * n * sizeof(float);
+    const size_t out_bytes = (size_t) m * n * sizeof(float);
+
+    static std::mutex cpu_mtx;
+    static std::unordered_map<const void *, std::vector<char>> weight_cache;
+    static std::vector<float> rhs_f32;
+    static std::vector<char> rhs_quant;
+    static std::vector<float> out;
+    static long long cpu_calls = 0;
+    std::lock_guard<std::mutex> cpu_lk(cpu_mtx);
+
+    auto it = weight_cache.find(src0->data);
+    if (it == weight_cache.end() || it->second.size() != weight_bytes) {
+        std::vector<char> weight(weight_bytes);
+        if (cudaMemcpy(weight.data(), src0->data, weight_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+        it = weight_cache.insert_or_assign(src0->data, std::move(weight)).first;
+    }
+    rhs_f32.resize((size_t) k * n);
+    rhs_quant.resize(rhs_row_bytes * (size_t) n);
+    out.resize((size_t) m * n);
+    if (cudaMemcpy(rhs_f32.data(), src1->data, rhs_f32_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+    for (long long col = 0; col < n; ++col) {
+        rhs_traits->from_float(rhs_f32.data() + (size_t) col * k,
+                               rhs_quant.data() + (size_t) col * rhs_row_bytes, k);
+    }
+
+    const char * threads_env = getenv("HETGPU_PACC_IQ1S_CPU_THREADS");
+    long long thread_count = threads_env ? strtoll(threads_env, nullptr, 0) : 16;
+    if (thread_count <= 0) thread_count = 1;
+    if (thread_count > m) thread_count = m;
+    std::atomic<long long> next_row(0);
+    std::vector<std::thread> workers;
+    workers.reserve((size_t) thread_count);
+    for (long long tid = 0; tid < thread_count; ++tid) {
+        workers.emplace_back([&]() {
+            for (;;) {
+                const long long row = next_row.fetch_add(1, std::memory_order_relaxed);
+                if (row >= m) break;
+                const void * weight = it->second.data() + (size_t) row * weight_row_bytes;
+                for (long long col = 0; col < n; ++col) {
+                    traits->vec_dot((int) k, out.data() + (size_t) col * m + row, 0,
+                                    weight, 0,
+                                    rhs_quant.data() + (size_t) col * rhs_row_bytes, 0, 1);
+                }
+            }
+        });
+    }
+    for (std::thread & worker : workers) worker.join();
+    if (cudaMemcpy(dst->data, out.data(), out_bytes, cudaMemcpyHostToDevice) != cudaSuccess) return false;
+    ++cpu_calls;
+    if (cpu_calls <= 128) {
+        fprintf(stderr, "[pacc-cpu] call#%lld type=%d m=%lld n=%lld k=%lld threads=%lld\n",
+                cpu_calls, src0->type, m, n, k, thread_count);
+    }
+    return true;
+}
+// Route src0 (weights) GEMM to PACC, keeping any quantized op away from the MMQ
+// kernel (which aborts on the fake PACC device). IQ1_S -> native atype=7;
+// other quantized/F16 -> dequant to F32 (host) + atype=4 transa=1. src0 is ggml
+// [k,m] row-major (row i contiguous), src1 [k,n] col-major, dst [m,n] col-major.
+static bool ggml_cuda_pacc_iq1s_mul_mat(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const char * candidate_trace = getenv("HETGPU_PACC_IQ1S_CANDIDATE_TRACE");
+    if (candidate_trace && candidate_trace[0] != '0') {
+        static long long ntraces = 0;
+        if (ntraces++ < 128) {
+            fprintf(stderr,
+                    "[pacc-iq1s] candidate type=%s name=%s src0=[%lld,%lld,%lld,%lld] src1=[%lld,%lld,%lld,%lld] dst=[%lld,%lld,%lld,%lld] contiguous=%d/%d/%d\n",
+                    ggml_type_name(src0->type), src0->name,
+                    (long long) src0->ne[0], (long long) src0->ne[1], (long long) src0->ne[2], (long long) src0->ne[3],
+                    (long long) src1->ne[0], (long long) src1->ne[1], (long long) src1->ne[2], (long long) src1->ne[3],
+                    (long long) dst->ne[0], (long long) dst->ne[1], (long long) dst->ne[2], (long long) dst->ne[3],
+                    ggml_is_contiguous(src0) ? 1 : 0, ggml_is_contiguous(src1) ? 1 : 0, ggml_is_contiguous(dst) ? 1 : 0);
+        }
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    const bool is_iq1s = (src0->type == GGML_TYPE_IQ1_S);
+    const bool is_quant = ggml_is_quantized(src0->type);
+    if (!is_quant && src0->type != GGML_TYPE_F16) return false;   // F32/BF16: leave to ggml (mmvf)
+    const char * q8_native = getenv("HETGPU_PACC_Q8_0_NATIVE_MMVF");
+    if (src0->type == GGML_TYPE_Q8_0 && q8_native && q8_native[0] == '1') return false;
+    const char * iq1s_only = getenv("HETGPU_PACC_IQ1S_ONLY");
+    if (!is_iq1s && (!iq1s_only || iq1s_only[0] != '0')) return false;
+    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) return false;
+    const long long k = src0->ne[0], m = src0->ne[1], n = src1->ne[1];
+    if (src1->ne[0] != k || dst->ne[0] != m || dst->ne[1] != n) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) return false;
+    if (is_iq1s && (k % 256 != 0)) return false;
+    // Allow deployment scripts to keep only the PACC shapes that outperform the
+    // CUDA fallback. Unset or zero values leave the corresponding field open.
+    const char * filter_type_env = getenv("HETGPU_PACC_IQ1S_FILTER_TYPE");
+    const char * filter_m_env = getenv("HETGPU_PACC_IQ1S_FILTER_M");
+    const char * filter_k_env = getenv("HETGPU_PACC_IQ1S_FILTER_K");
+    const long long filter_type = filter_type_env ? strtoll(filter_type_env, nullptr, 0) : 0;
+    const long long filter_m = filter_m_env ? strtoll(filter_m_env, nullptr, 0) : 0;
+    const long long filter_k = filter_k_env ? strtoll(filter_k_env, nullptr, 0) : 0;
+    if ((filter_type != 0 && filter_type != src0->type) ||
+        (filter_m != 0 && filter_m != m) ||
+        (filter_k != 0 && filter_k != k)) {
+        const char * cpu_fallback = getenv("HETGPU_PACC_IQ1S_CPU_FALLBACK");
+        return cpu_fallback && cpu_fallback[0] == '1' &&
+               ggml_cuda_pacc_cpu_mul_mat(src0, src1, dst);
+    }
+    static std::mutex mtx;
+    static int fd = -1;
+    static unsigned long long base = 0, uoff = 0;
+    static std::unordered_map<const void *, unsigned long long> wcache;  // src0->data -> staged weight off
+    static unsigned long long weight_start = 0;
+    static unsigned long long wnext = 0;
+    static unsigned long long scratch = 0;
+    static char * hbuf = nullptr; static size_t hcap = 0;       // full dequantized/native A
+    static char * qbuf = nullptr; static size_t qcap = 0;       // raw A, then packed A tile
+    static char * bbuf = nullptr; static size_t bcap = 0;       // full column-major B
+    static char * tbuf = nullptr; static size_t tcap = 0;       // packed B tile or returned C tile
+    static char * obuf = nullptr; static size_t ocap = 0;       // assembled column-major C
+    static long long ncalls = 0;
+    std::lock_guard<std::mutex> lk(mtx);
+    if (fd < 0) {
+        const char * be = getenv("HETGPU_PACC_SHARED_DDR_BASE"); base = be ? strtoull(be,0,0) : 0x20110600000ULL;
+        const char * ue = getenv("HETGPU_PACC_SHARED_DDR_USER_OFF"); uoff = ue ? strtoull(ue,0,0) : 0x100000ULL;
+        const char * ws = getenv("HETGPU_PACC_IQ1S_WEIGHT_OFF"); weight_start = ws ? strtoull(ws,0,0) : 0x1000000ULL;
+        const char * ss = getenv("HETGPU_PACC_IQ1S_SCRATCH_OFF"); scratch = ss ? strtoull(ss,0,0) : 0x80000000ULL;
+        if (scratch <= weight_start) scratch = weight_start + 0x10000000ULL;
+        wnext = weight_start;
+        const char * cd = getenv("HETGPU_PACC_IQ1S_COH_DEV"); if (!cd) cd = "/dev/hetgpu_pacc_mbox_ddr_coh0";
+        fd = open(cd, O_RDWR | O_SYNC);
+        if (fd < 0) { fprintf(stderr, "[pacc-iq1s] open %s failed\n", cd); return false; }
+    }
+    // A staged bytes + submit params depend on native-IQ1_S vs dequant-F32.
+    int a_atype; int a_transa; long long a_lda; size_t a_bytes;
+    if (is_iq1s) { a_atype = 7; a_transa = 0; a_lda = (k/256)*50; a_bytes = (size_t)m*a_lda; }
+    else         { a_atype = 4; a_transa = 1; a_lda = k;          a_bytes = (size_t)m*k*4; }
+    const size_t b_bytes = (size_t)k*n*4, c_bytes = (size_t)m*n*4;
+    const char * tile_env = getenv("HETGPU_PACC_IQ1S_MAX_TILE_M");
+    long long max_tile_m = tile_env ? strtoll(tile_env, nullptr, 0) : 2048;
+    if (max_tile_m <= 0 || max_tile_m > m) max_tile_m = m;
+    const char * tile_k_env = getenv("HETGPU_PACC_IQ1S_MAX_TILE_K");
+    long long max_tile_k = tile_k_env ? strtoll(tile_k_env, nullptr, 0) : 6144;
+    if (max_tile_k <= 0 || max_tile_k > k) max_tile_k = k;
+    if (is_iq1s) max_tile_k = (max_tile_k / 256) * 256;
+    if (max_tile_k <= 0) return false;
+    const bool k_tiled = max_tile_k < k;
+    const char * max_weight_env = getenv("HETGPU_PACC_IQ1S_MAX_WEIGHT_BYTES");
+    const size_t max_weight_bytes = max_weight_env ? strtoull(max_weight_env, nullptr, 0) : (512ULL << 20);
+    if (max_weight_bytes != 0 && a_bytes > max_weight_bytes) {
+        static long long nskips = 0;
+        if (nskips++ < 8) {
+            fprintf(stderr,
+                    "[pacc-iq1s] skip oversized weight type=%d m=%lld n=%lld k=%lld bytes=0x%zx limit=0x%zx\n",
+                    src0->type, m, n, k, a_bytes, max_weight_bytes);
+        }
+        return false;
+    }
+    if (a_bytes > hcap) { free(hbuf); hbuf = (char*)malloc(a_bytes); hcap = a_bytes; if (!hbuf){hcap=0;return false;} }
+    if (b_bytes > bcap) { free(bbuf); bbuf = (char*)malloc(b_bytes); bcap = b_bytes; if (!bbuf){bcap=0;return false;} }
+    const size_t max_tile_b_bytes = (size_t) max_tile_k * n * sizeof(float);
+    const size_t max_tile_c_bytes = (size_t) max_tile_m * n * sizeof(float);
+    const size_t tile_need = max_tile_b_bytes > max_tile_c_bytes ? max_tile_b_bytes : max_tile_c_bytes;
+    if (tile_need > tcap) { free(tbuf); tbuf = (char*)malloc(tile_need); tcap = tile_need; if (!tbuf){tcap=0;return false;} }
+    if (c_bytes > ocap) { free(obuf); obuf = (char*)malloc(c_bytes); ocap = c_bytes; if (!obuf){ocap=0;return false;} }
+    unsigned long long off_a; bool staged = false;
+    auto it = wcache.find(src0->data);
+    if (it == wcache.end()) {
+        off_a = wnext; wnext = (wnext + a_bytes + 63) & ~63ULL;
+        if (wnext >= scratch) {
+            const char * reset = getenv("HETGPU_PACC_IQ1S_CACHE_RESET");
+            if (reset && reset[0] == '0') {
+                fprintf(stderr, "[pacc-iq1s] weight cache overflow off=0x%llx bytes=0x%zx scratch=0x%llx\n", off_a, a_bytes, scratch);
+                return false;
+            }
+            fprintf(stderr, "[pacc-iq1s] weight cache reset off=0x%llx bytes=0x%zx scratch=0x%llx\n", off_a, a_bytes, scratch);
+            wcache.clear();
+            off_a = weight_start;
+            wnext = (weight_start + a_bytes + 63) & ~63ULL;
+            if (wnext >= scratch) {
+                fprintf(stderr, "[pacc-iq1s] single weight too large bytes=0x%zx scratch=0x%llx\n", a_bytes, scratch);
+                return false;
+            }
+        }
+        if (is_iq1s) {
+            if (cudaMemcpy(hbuf, src0->data, a_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+        } else {
+            const size_t qb = ggml_nbytes(src0);
+            if (qb > qcap) { free(qbuf); qbuf = (char*)malloc(qb); qcap = qb; if (!qbuf){qcap=0;return false;} }
+            if (cudaMemcpy(qbuf, src0->data, qb, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+            const auto * tr = ggml_get_type_traits(src0->type);
+            if (!tr || !tr->to_float) { fprintf(stderr, "[pacc-iq1s] no to_float for type %d\n", src0->type); return false; }
+            tr->to_float(qbuf, (float*)hbuf, (int64_t)m*k);   // row-major W[m][k] -> F32
+        }
+        if (k_tiled) {
+            unsigned long long packed_off = off_a;
+            const size_t full_a_row_bytes = is_iq1s ? (size_t) a_lda : (size_t) k * sizeof(float);
+            for (long long kk = 0; kk < k; kk += max_tile_k) {
+                const long long tile_k = (k - kk) < max_tile_k ? (k - kk) : max_tile_k;
+                if (is_iq1s && (tile_k % 256 != 0)) return false;
+                const size_t src_k_off = is_iq1s ? (size_t) (kk / 256) * 50 : (size_t) kk * sizeof(float);
+                const size_t tile_a_row_bytes = is_iq1s ? (size_t) (tile_k / 256) * 50 : (size_t) tile_k * sizeof(float);
+                const size_t packed_bytes = (size_t) m * tile_a_row_bytes;
+                if (packed_bytes > qcap) {
+                    free(qbuf); qbuf = (char *) malloc(packed_bytes); qcap = packed_bytes;
+                    if (!qbuf) { qcap = 0; return false; }
+                }
+                for (long long row = 0; row < m; ++row) {
+                    memcpy(qbuf + (size_t) row * tile_a_row_bytes,
+                           hbuf + (size_t) row * full_a_row_bytes + src_k_off,
+                           tile_a_row_bytes);
+                }
+                if (pwrite(fd, qbuf, packed_bytes, (off_t)(uoff + packed_off)) != (ssize_t)packed_bytes) return false;
+                packed_off += packed_bytes;
+            }
+            if (packed_off != off_a + a_bytes) return false;
+        } else if (pwrite(fd, hbuf, a_bytes, (off_t)(uoff+off_a)) != (ssize_t)a_bytes) {
+            return false;
+        }
+        wcache[src0->data] = off_a; staged = true;
+    } else off_a = it->second;
+    struct timespec _t0,_t1; clock_gettime(CLOCK_MONOTONIC,&_t0);
+    const unsigned long long off_b = scratch;
+    const unsigned long long off_c = (off_b + b_bytes + 63) & ~63ULL;
+    if (cudaMemcpy(bbuf, src1->data, b_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+    if (!k_tiled && pwrite(fd, bbuf, b_bytes, (off_t)(uoff+off_b)) != (ssize_t)b_bytes) return false;
+    const size_t full_a_row_bytes = is_iq1s ? (size_t) a_lda : (size_t) k * sizeof(float);
+    memset(obuf, 0, c_bytes);
+    int tiles = 0;
+    unsigned long long packed_a_prefix = 0;
+    for (long long kk = 0; kk < k; kk += max_tile_k) {
+        const int tile_k = (int) ((k - kk) < max_tile_k ? (k - kk) : max_tile_k);
+        if (is_iq1s && (tile_k % 256 != 0)) return false;
+        const size_t a_k_off = is_iq1s ? (size_t) (kk / 256) * 50 : (size_t) kk * sizeof(float);
+        const size_t tile_a_row_bytes = is_iq1s ? (size_t) (tile_k / 256) * 50 : (size_t) tile_k * sizeof(float);
+        const int tile_a_lda = k_tiled ? (is_iq1s ? (int) tile_a_row_bytes : tile_k) : (int) a_lda;
+        const int tile_b_ldb = k_tiled ? tile_k : (int) k;
+        if (k_tiled) {
+            const size_t tile_b_bytes = (size_t) tile_k * n * sizeof(float);
+            for (long long col = 0; col < n; ++col) {
+                memcpy(tbuf + (size_t) col * tile_k * sizeof(float),
+                       bbuf + ((size_t) col * k + kk) * sizeof(float),
+                       (size_t) tile_k * sizeof(float));
+            }
+            if (pwrite(fd, tbuf, tile_b_bytes, (off_t)(uoff + off_b)) != (ssize_t)tile_b_bytes) return false;
+        }
+        const char * workers_env = getenv("HETGPU_PACC_IQ1S_WORKERS");
+        long long worker_count = workers_env ? strtoll(workers_env, nullptr, 0) : 4;
+        const long long row_tasks = (m + max_tile_m - 1) / max_tile_m;
+        if (worker_count <= 0) worker_count = 1;
+        if (worker_count > row_tasks) worker_count = row_tasks;
+        std::atomic<long long> next_row(0);
+        std::atomic<int> failed(0);
+        std::vector<std::thread> workers;
+        workers.reserve((size_t) worker_count);
+        for (long long worker = 0; worker < worker_count; ++worker) {
+            workers.emplace_back([&, kk, tile_k, tile_a_lda, tile_b_ldb, a_k_off,
+                                  tile_a_row_bytes, packed_a_prefix]() {
+                while (failed.load(std::memory_order_relaxed) == 0) {
+                    const long long row = next_row.fetch_add(max_tile_m, std::memory_order_relaxed);
+                    if (row >= m) break;
+                    const int tile_m = (int) ((m - row) < max_tile_m ? (m - row) : max_tile_m);
+                    const unsigned long long tile_a = k_tiled
+                        ? off_a + packed_a_prefix + (unsigned long long) row * tile_a_row_bytes
+                        : off_a + (unsigned long long) row * full_a_row_bytes + a_k_off;
+                    const unsigned long long tile_b = k_tiled ? off_b : off_b + (unsigned long long) kk * sizeof(float);
+                    const unsigned long long tile_c = off_c
+                        + (unsigned long long) (row / max_tile_m) * max_tile_c_bytes;
+                    int rc = hetgpu_pacc_submit_gemm(a_transa, 0, tile_m, (int)n, tile_k, nullptr,
+                        (const void*)(base+tile_a), a_atype, tile_a_lda, 0,
+                        (const void*)(base+tile_b), 4, tile_b_ldb, 0,
+                        nullptr, (void*)(base+tile_c), 4, tile_m, 0, 1, 4);
+                    if (rc != 0) {
+                        fprintf(stderr,
+                                "[pacc-iq1s] submit rc=%d type=%d m=%lld tile_row=%lld tile_m=%d n=%lld k=%lld tile_k_off=%lld tile_k=%d\n",
+                                rc, src0->type, m, row, tile_m, n, k, kk, tile_k);
+                        failed.store(1, std::memory_order_relaxed);
+                        break;
+                    }
+                }
+            });
+        }
+        for (std::thread & worker : workers) worker.join();
+        if (failed.load(std::memory_order_relaxed) != 0) return false;
+        for (long long row = 0; row < m; row += max_tile_m) {
+            const int tile_m = (int) ((m - row) < max_tile_m ? (m - row) : max_tile_m);
+            const size_t tile_c_bytes = (size_t) tile_m * n * sizeof(float);
+            const unsigned long long tile_c = off_c
+                + (unsigned long long) (row / max_tile_m) * max_tile_c_bytes;
+            const ssize_t got = pread(fd, tbuf, tile_c_bytes, (off_t)(uoff + tile_c));
+            if (got != (ssize_t) tile_c_bytes) {
+                fprintf(stderr,
+                        "[pacc-iq1s] output read failed type=%d row=%lld got=%zd expected=%zu errno=%d\n",
+                        src0->type, row, got, tile_c_bytes, errno);
+                return false;
+            }
+            for (long long col = 0; col < n; ++col) {
+                float * dst_col = (float *) obuf + (size_t) col * m + row;
+                const float * src_col = (const float *) tbuf + (size_t) col * tile_m;
+                for (int r = 0; r < tile_m; ++r) dst_col[r] += src_col[r];
+            }
+            ++tiles;
+        }
+        if (k_tiled) packed_a_prefix += (unsigned long long) m * tile_a_row_bytes;
+    }
