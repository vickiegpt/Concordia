+// Keep unsupported fake-CUDA quantized kernels out of the mixed path while
+// reusing llama.cpp's optimized host quantized dot products. This is enabled
+// only when an explicit PACC shape filter is active.
+static bool ggml_cuda_pacc_cpu_mul_mat(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const auto * traits = ggml_get_type_traits_cpu(src0->type);
+    if (!traits || !traits->vec_dot) return false;
+    const auto * rhs_traits = ggml_get_type_traits_cpu(traits->vec_dot_type);
+    if (!rhs_traits || !rhs_traits->from_float) return false;
+
+    const long long k = src0->ne[0], m = src0->ne[1], n = src1->ne[1];
+    const size_t weight_row_bytes = ggml_row_size(src0->type, k);
+    const size_t weight_bytes = weight_row_bytes * (size_t) m;
+    const size_t rhs_row_bytes = ggml_row_size(traits->vec_dot_type, k);
+    const size_t rhs_f32_bytes = (size_t) k * n * sizeof(float);
+    const size_t out_bytes = (size_t) m * n * sizeof(float);
+
+    static std::mutex cpu_mtx;
+    static std::unordered_map<const void *, std::vector<char>> weight_cache;
+    static std::vector<float> rhs_f32;
+    static std::vector<char> rhs_quant;
+    static std::vector<float> out;
+    static long long cpu_calls = 0;
+    std::lock_guard<std::mutex> cpu_lk(cpu_mtx);
+
+    auto it = weight_cache.find(src0->data);
+    if (it == weight_cache.end() || it->second.size() != weight_bytes) {
+        std::vector<char> weight(weight_bytes);
+        if (cudaMemcpy(weight.data(), src0->data, weight_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+        it = weight_cache.insert_or_assign(src0->data, std::move(weight)).first;
+    }
+    rhs_f32.resize((size_t) k * n);
+    rhs_quant.resize(rhs_row_bytes * (size_t) n);
+    out.resize((size_t) m * n);
+    if (cudaMemcpy(rhs_f32.data(), src1->data, rhs_f32_bytes, cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+    for (long long col = 0; col < n; ++col) {
+        rhs_traits->from_float(rhs_f32.data() + (size_t) col * k,
+                               rhs_quant.data() + (size_t) col * rhs_row_bytes, k);
+    }
+
+    const char * threads_env = getenv("HETGPU_PACC_IQ1S_CPU_THREADS");
+    long long thread_count = threads_env ? strtoll(threads_env, nullptr, 0) : 16;
+    if (thread_count <= 0) thread_count = 1;
+    if (thread_count > m) thread_count = m;
+    std::atomic<long long> next_row(0);
+    std::vector<std::thread> workers;
+    workers.reserve((size_t) thread_count);
+    for (long long tid = 0; tid < thread_count; ++tid) {
+        workers.emplace_back([&]() {
+            for (;;) {
+                const long long row = next_row.fetch_add(1, std::memory_order_relaxed);
+                if (row >= m) break;
+                const void * weight = it->second.data() + (size_t) row * weight_row_bytes;
+                for (long long col = 0; col < n; ++col) {
+                    traits->vec_dot((int) k, out.data() + (size_t) col * m + row, 0,
+                                    weight, 0,
+                                    rhs_quant.data() + (size_t) col * rhs_row_bytes, 0, 1);
+                }
+            }
+        });
+    }
+    for (std::thread & worker : workers) worker.join();
+    if (cudaMemcpy(dst->data, out.data(), out_bytes, cudaMemcpyHostToDevice) != cudaSuccess) return false;
+    ++cpu_calls;
+    if (cpu_calls <= 128) {
+        fprintf(stderr, "[pacc-cpu] call#%lld type=%d m=%lld n=%lld k=%lld threads=%lld\n",
+                cpu_calls, src0->type, m, n, k, thread_count);
+    }
+    return true;
+}
+static uint16_t ggml_pacc_f32_to_bf16(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    bits += 0x7fffU + ((bits >> 16) & 1U);
+    return (uint16_t) (bits >> 16);
+}
+static float ggml_pacc_bf16_to_f32(uint16_t value) {
+    uint32_t bits = (uint32_t) value << 16;
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
