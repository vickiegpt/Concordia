.version 8.7
.target sm_120
.address_size 64

.visible .entry fma_bits(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<6>;
    .reg .f32 %f<5>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];
    and.b32 %r6, %r6, 1023;

    cvt.rn.f32.u32 %f1, %r6;
    mov.f32 %f2, 0f3FA00000;
    mov.f32 %f3, 0f40400000;
    fma.rn.f32 %f4, %f1, %f2, %f3;
    cvt.rzi.u32.f32 %r7, %f4;

    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r7;

DONE:
    ret;
}
