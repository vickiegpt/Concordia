.version 8.7
.target sm_120
.address_size 64

.visible .entry int_add(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];
    add.u32 %r7, %r6, 17;
    xor.b32 %r7, %r7, 0x5a5a5a5a;
    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r7;

DONE:
    ret;
}
