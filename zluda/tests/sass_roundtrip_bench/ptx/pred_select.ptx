.version 8.7
.target sm_120
.address_size 64

.visible .entry pred_select(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<11>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];

    and.b32 %r7, %r5, 1;
    setp.eq.u32 %p2, %r7, 0;
    shl.b32 %r8, %r6, 1;
    shr.u32 %r9, %r6, 1;
    selp.u32 %r10, %r8, %r9, %p2;

    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r10;

DONE:
    ret;
}
