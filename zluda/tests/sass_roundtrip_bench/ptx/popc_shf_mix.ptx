.version 8.7
.target sm_120
.address_size 64

.visible .entry popc_shf_mix(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<13>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];

    popc.b32 %r7, %r6;
    shf.l.wrap.b32 %r8, %r6, %r6, 7;
    and.b32 %r9, %r8, 0x00ff00ff;
    shl.b32 %r10, %r7, 16;
    xor.b32 %r11, %r9, %r10;
    add.u32 %r12, %r11, %r5;

    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r12;

DONE:
    ret;
}
