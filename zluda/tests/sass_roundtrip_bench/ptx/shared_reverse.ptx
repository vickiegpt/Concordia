.version 8.7
.target sm_120
.address_size 64

.visible .entry shared_reverse(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<10>;
    .shared .align 4 .b8 scratch[512];

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];

    mul.wide.u32 %rd5, %r2, 4;
    mov.u64 %rd6, scratch;
    add.u64 %rd7, %rd6, %rd5;
    st.shared.u32 [%rd7], %r6;
    bar.sync 0;

    sub.u32 %r7, %r4, 1;
    sub.u32 %r8, %r7, %r2;
    mul.wide.u32 %rd8, %r8, 4;
    add.u64 %rd9, %rd6, %rd8;
    ld.shared.u32 %r9, [%rd9];
    xor.b32 %r10, %r9, 0x00ff00ff;

    add.u64 %rd4, %rd1, %rd3;
    st.global.u32 [%rd4], %r10;

DONE:
    ret;
}
