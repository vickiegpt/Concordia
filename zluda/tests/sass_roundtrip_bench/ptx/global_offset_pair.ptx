.version 8.7
.target sm_120
.address_size 64

.visible .entry global_offset_pair(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    add.u32 %r6, %r5, 1;
    setp.ge.u32 %p2, %r6, %r1;
    selp.u32 %r6, %r5, %r6, %p2;

    mul.wide.u32 %rd3, %r5, 4;
    mul.wide.u32 %rd4, %r6, 4;
    add.u64 %rd5, %rd2, %rd3;
    add.u64 %rd6, %rd2, %rd4;
    ld.global.u32 %r7, [%rd5];
    ld.global.u32 %r8, [%rd6];

    shl.b32 %r9, %r8, 3;
    shr.u32 %r10, %r7, 5;
    add.u32 %r11, %r9, %r10;
    xor.b32 %r12, %r11, %r5;
    add.u32 %r13, %r12, 0x13579bdf;

    add.u64 %rd7, %rd1, %rd3;
    st.global.u32 [%rd7], %r13;

DONE:
    ret;
}
