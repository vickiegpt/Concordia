.version 8.7
.target sm_120
.address_size 64

.visible .entry kimi_swiglu_mix(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<14>;
    .reg .b64 %rd<6>;
    .reg .f32 %f<9>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];

    and.b32 %r7, %r6, 1023;
    shr.u32 %r8, %r6, 10;
    and.b32 %r8, %r8, 1023;
    cvt.rn.f32.u32 %f1, %r7;
    cvt.rn.f32.u32 %f2, %r8;
    mov.f32 %f3, 0f3C23D70A;
    mov.f32 %f4, 0f3F800000;
    fma.rn.f32 %f5, %f1, %f3, %f4;
    mul.rn.f32 %f6, %f2, %f5;
    mov.f32 %f7, 0f43800000;
    setp.gt.f32 %p2, %f6, %f7;
    selp.f32 %f8, %f7, %f6, %p2;
    cvt.rzi.u32.f32 %r9, %f8;
    shl.b32 %r10, %r9, 3;
    shr.u32 %r11, %r6, 21;
    xor.b32 %r12, %r10, %r11;
    add.u32 %r13, %r12, %r5;

    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r13;

DONE:
    ret;
}
